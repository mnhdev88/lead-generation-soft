# Copy this file to ".env" (same folder) and fill in your values.
# .env is never committed to git. Put real keys ONLY in .env, never in this file.
# After changing .env, restart the backend (close and re-run start-all.bat).

# Google Places API key (Step 2). Leave empty to use only OpenStreetMap.
GOOGLE_PLACES_API_KEY=

# Max Google Places requests per month. Google gives 1,000 free search requests a month per
# billing account; this counter covers only THIS install. If your PC and the server use the
# same key, split it (e.g. 450 each) or leave the key empty on one of them.
GOOGLE_PLACES_MONTHLY_LIMIT=900

# 1 = also get up to 5 reviews + the photo count of each business (review complaints,
# "possibly new business"). Billed by Google at $40 per 1,000 instead of $35 per 1,000, but
# the first 1,000 a month are free either way, so keep the limit above at or below 1,000.
GOOGLE_PLACES_REVIEWS=1

# Google PageSpeed (free): mobile speed + SEO score of each website, a few at a time.
# Get a free key (Google Cloud > APIs & Services > enable "PageSpeed Insights API" >
# Credentials > API key, restricted to that API): 25,000 tests a day. Without a key Google
# often answers "quota exceeded" and few websites get tested.
PAGESPEED_ENABLED=1
PAGESPEED_API_KEY=

# Optional: your email, sent to OpenStreetMap so they can contact you about heavy usage.
CONTACT_EMAIL=

# --- Email verification (Step 4) ---
# 1 = ask mail servers whether an address exists (needs port 25 open). 0 = only format + domain checks.
SMTP_VERIFY=1
# Optional: a domain you own, used to introduce ourselves to mail servers (improves results).
SMTP_HELO_HOST=
SMTP_MAIL_FROM=

# Optional: Hunter.io API key, a backup for finding emails when a website blocks the crawler.
# Free plan = 25 searches/month.
HUNTER_API_KEY=
HUNTER_MONTHLY_LIMIT=25

# --- Find owners / decision-makers (optional) ---
# The app never opens linkedin.com. It asks a web search API for LinkedIn profiles of a
# business's owner and reads only the search results. Pick ONE provider:
#   brave  = Brave Search API (https://brave.com/search/api/): about $5 free credit a month
#            (~1,000 searches), then $5 per 1,000.
#   serper = Serper.dev (Google results): 2,500 free searches once per account, then about
#            $1 per 1,000.
# (Google's Custom Search API is closed to new users and shuts down on 1 Jan 2027.)
WEB_SEARCH_PROVIDER=brave
BRAVE_API_KEY=
SERPER_API_KEY=
# Max web searches per month (each company uses 1, or 2 when its LinkedIn page is unknown).
WEB_SEARCH_MONTHLY_LIMIT=900

# Optional: Apollo.io API key, a backup when the web search finds no owner.
# Searching is free; each email revealed costs 1 Apollo credit (phone numbers are never asked for).
APOLLO_API_KEY=
APOLLO_MONTHLY_LIMIT=50

# "Find owner" skips a business looked up less than this many days ago (saves searches).
PEOPLE_RECHECK_DAYS=90
# 1 = also search for each business's LinkedIn company page (a 2nd web search per business).
LINKEDIN_COMPANY_PAGE_SEARCH=0

# --- Google Sheets export (optional) ---
# Full path to a Google service-account JSON key file (see README "Google Sheets export").
GOOGLE_SHEETS_CREDENTIALS_FILE=

# --- Login & security ---
# On the server (https) set these three. On your own computer, leave them as they are.
#   COOKIE_SECURE=1            login cookie only travels over https
#   FRONTEND_ORIGINS=https://leadgen.yourdomain.com
#   API_DOCS=0                 hide the /docs pages
COOKIE_SECURE=0
FRONTEND_ORIGINS=http://localhost:3000
API_DOCS=1
# How long a login lasts: logged out after SESSION_IDLE_HOURS unused, and after SESSION_DAYS at most.
SESSION_IDLE_HOURS=12
SESSION_DAYS=7
# Wrong passwords before an account is locked, and for how long.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
